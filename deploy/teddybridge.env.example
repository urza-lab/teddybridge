# teddybridge – Beispielkonfiguration. Kopieren nach /etc/teddybridge/teddybridge.env, Rechte 600, Besitzer Dienstbenutzer.
# Keine Kommentare hinter Werten (systemd liest sie als Teil des Werts), nur ganze Kommentarzeilen.

# ---- Pflicht: TeddyCloud
# Adresse der TeddyCloud-Weboberfläche, z. B. http://teddycloud.example (im Docker-Netz: http://teddycloud)
TC_URL=

# ---- Pflicht: mindestens eine Quelle (Audiobookshelf, Navidrome und/oder Dateiquelle)
# Eine Quelle ist entweder vollständig ausgefüllt oder ganz leer; halb ausgefüllt bricht den Start ab.
#
# Audiobookshelf, z. B. http://audiobookshelf.example:13378
ABS_URL=
# API-Token eines eigenen ABS-Benutzers mit Lesezugriff + Download
ABS_TOKEN=
#
# Navidrome, z. B. http://navidrome.example:4533 (eigener Benutzer ohne Admin-Rechte)
ND_URL=
ND_USER=
ND_PASS=
#
# Dateiquelle (z. B. NAS per NFS/SMB, nur lesend eingehängt): Name=/pfad, mehrere mit ';'
# z. B. Hörspiele=/mnt/nas/hoerspiele;Musik=/mnt/nas/musik
FS_ROOTS=

# ---- Dringend empfohlen: Login (beide leer = ohne Login)
UI_USER=
# erzeugen mit: venv/bin/python -m app.pwhash   (Docker: docker compose run --rm -it teddybridge python -m app.pwhash)
UI_PASS_HASH=

# ---- Optional
# "user:pass", falls TeddyCloud Basic Auth hat
TC_AUTH=
# Basisordner in der TeddyCloud-Bibliothek
TC_BASE=teddybridge
# weitere Ordner, die nur auf vorhandene TAFs durchsucht werden (z. B. ein früherer Basisordner), mit Komma getrennt
TC_BASE_EXTRA=
LISTEN=0.0.0.0:8085
DISCORD_WEBHOOK=
# Sprache: de oder en (fest, ohne Auswahl); leer = Sprache des Browsers, umschaltbar
UI_LANG=
# IP(s) eines Reverse Proxys, mit Komma getrennt (dann gelten X-Forwarded-For/-Proto von dort)
TRUSTED_PROXIES=
