# teddybridge – example configuration. Copy to /etc/teddybridge/teddybridge.env, mode 600, owned by the service user.
# No comments after values (systemd reads them as part of the value), only whole comment lines.

# ---- Required: TeddyCloud
# Address of the TeddyCloud web UI, e.g. http://teddycloud.example (in a Docker network: http://teddycloud)
TC_URL=

# ---- Required: at least one source (Audiobookshelf, Navidrome and/or file source)
# A source is either filled in completely or left empty; a half-filled source aborts the start.
#
# Audiobookshelf, e.g. http://audiobookshelf.example:13378
ABS_URL=
# API token of a dedicated ABS user with read access + download
ABS_TOKEN=
#
# Navidrome, e.g. http://navidrome.example:4533 (dedicated user without admin rights)
ND_URL=
ND_USER=
ND_PASS=
#
# File source (e.g. NAS via NFS/SMB, mounted read-only): Name=/path, several separated by ';'
# e.g. Audiobooks=/mnt/nas/audiobooks;Music=/mnt/nas/music
FS_ROOTS=

# ---- Strongly recommended: login (both empty = no login)
UI_USER=
# generate with: venv/bin/python -m app.pwhash   (Docker: docker compose run --rm -it teddybridge python -m app.pwhash)
UI_PASS_HASH=

# ---- Optional
# "user:pass" if TeddyCloud uses basic auth
TC_AUTH=
# Base folder in the TeddyCloud library
TC_BASE=teddybridge
# Additional folders that are only searched for existing TAFs (e.g. a former base folder), comma-separated
TC_BASE_EXTRA=
LISTEN=0.0.0.0:8085
DISCORD_WEBHOOK=
# Language: de or en (fixed, no selector); empty = browser language, switchable in the UI
UI_LANG=
# IP(s) of a reverse proxy, comma-separated (X-Forwarded-For/-Proto from there are then trusted)
TRUSTED_PROXIES=
