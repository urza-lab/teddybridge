[Unit]
Description=teddybridge – Hörspiele und Musik aus Audiobookshelf/Navidrome nach TeddyCloud
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=teddybridge
Group=teddybridge
WorkingDirectory=/opt/teddybridge
# optional: configuration as env file; "-" = may be missing (then the setup in the browser is used)
EnvironmentFile=-/etc/teddybridge/teddybridge.env
# settings from the setup in the browser (since 1.2); variables from the env file take precedence
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TB_CONFIG_FILE=/var/lib/teddybridge/teddybridge.env
StateDirectory=teddybridge
StateDirectoryMode=0700
ExecStart=/opt/teddybridge/venv/bin/python -m app
Restart=on-failure
RestartSec=5

# Härtung
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
